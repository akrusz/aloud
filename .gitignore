.DS_Store
sessions/

# Generated icon set (scripts/generate-icon.sh)
*.iconset

# Hosted UI build output — published to Pages by deploy-web.yml as an
# ephemeral artifact, no longer committed (avoids stale build drift).
docs/app/

# Recreational Claude scratchpad
recess.md

# Local state written by ts/server/scripts/durability-probe.sh (the marker id
# it writes before a stop/redeploy and reads back after) — ephemeral, per-run.
.durability-probe.json

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
