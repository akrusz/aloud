                "tour-focus": {
                    "file": "serena/zh/tour-focus.0f4f77bd.mp3",
                    "text": "焦点告诉我你打算把注意力放在哪里：身体、情绪，或内在的各个部分。也可以不选。"
                },
                "tour-hello": {
                    "file": "serena/zh/tour-hello.d228eb8b.mp3",
                    "text": "欢迎来到 aloud，一款会说也会听的冥想应用。打开麦克风，你就可以直接开口回答我。"
                },
                "tour-noting": {
