<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Merged into the macOS bundle's Info.plist by tauri-build. macOS denies
     (and can hard-kill) apps that touch the mic without this usage string. -->
<plist version="1.0">
<dict>
	<key>NSMicrophoneUsageDescription</key>
	<string>aloud uses the microphone to hear you during meditation sessions.</string>
</dict>
</plist>
