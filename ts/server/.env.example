# aloud cloud config. Copy to .env (gitignored) and fill in, or set these as
# host secrets (Fly/Render). Secrets NEVER go in the repo.

# Set to "production" to enforce required-secret checks and the content-check
# downgrade. Anything else (or unset) runs in permissive dev mode.
ALOUD_ENV=

# Enables POST /cloud/v1/auth/dev (the local sign-in shortcut that mints a
# session without Google). Explicit OPT-IN: leave unset on any deploy; set to 1
# in your local .env so the browser-dev workflow can sign in without OAuth.
ALOUD_ENABLE_DEV_AUTH=1

PORT=8787

# Durable SQLite credit-ledger file. REQUIRED in production — without it the
# server falls back to an in-memory ledger that loses every account balance on
# restart/redeploy. Point it at a persistent volume (on Fly: a mounted volume,
# e.g. /data/aloud.db). Unset in dev = ephemeral in-memory store — which wipes
# accounts on every tsx-watch restart and forces a fresh sign-in, so for local
# work set something like .data/aloud-dev.db (gitignored; mkdir .data first).
ALOUD_DB_PATH=

# --- Backups: Litestream → Cloudflare R2 (dev-docs/deploy.md → Backups) ---
# Continuously replicate the ledger (ALOUD_DB_PATH) off the single Fly volume.
# The container entrypoint restores from R2 on a fresh volume, then runs the
# server under replication. Set ALL FOUR in production. Leave unset in dev /
# self-host without backups — the entrypoint then just runs the server directly.
R2_BUCKET=
R2_ENDPOINT=          # https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=     # R2 API token, Object Read & Write on the bucket. Secret.
R2_SECRET_ACCESS_KEY= # Secret.

# Comma-separated origins allowed to call the API from a browser. Must include
# the web UI origin AND the desktop webview origins, e.g.:
#   https://aloud.rest,tauri://localhost,http://tauri.localhost,capacitor://localhost,https://localhost
# Origins by platform:
#   https://aloud.rest      web
#   tauri://localhost       desktop (macOS/Linux); http://tauri.localhost (Windows)
#   capacitor://localhost   iOS (Capacitor app)
#   https://localhost       Android (Capacitor app)
# Missing an origin → that app's /app/v1 + /cloud/v1 calls are CORS-blocked
# (no providers/voices/sign-in), invisible unless tested in the real app.
# REQUIRED in production — unset, CORS falls open to '*' (dev-only behavior).
ALOUD_CORS_ORIGINS=

# Secret for signing our own session JWTs. Generate: openssl rand -hex 32
ALOUD_SESSION_SECRET=

# Google OAuth client id(s) accepted as the audience of incoming ID tokens.
# Comma-separated if you have web + iOS + android client ids.
GOOGLE_CLIENT_IDS=

# Desktop (Tauri) Google sign-in via the loopback PKCE flow (meditation-pal-fae).
# A "Desktop app" OAuth client: the id is public (it appears in the auth URL),
# the secret stays server-side — this server performs the code→token exchange so
# the secret never ships in the desktop binary. Empty = desktop Google sign-in
# disabled (web Google sign-in via GOOGLE_CLIENT_IDS is unaffected).
GOOGLE_DESKTOP_CLIENT_ID=
GOOGLE_DESKTOP_CLIENT_SECRET=

# Sign in with Apple (meditation-pal-s75). The Services ID(s) accepted as the
# audience of incoming Apple identity tokens (web uses the Services ID; native
# uses the app bundle id). Comma-separated. Empty = Apple sign-in disabled.
# Email/password sign-in needs no config — it's always on.
APPLE_CLIENT_IDS=

# Free credits granted to a new VERIFIED account (meditation-pal-2yb).
# 20 credits ≈ $1.00 of provider cost/signup (credits debit at cost). ~3-4
# mid-tier or ~10 value-tier sessions; bounds abuse blast radius per account.
ALOUD_FREE_SIGNUP_CREDITS=20

# Emergency brake: max free credits granted across ALL signups per rolling hour.
# Default 2000 ≈ 100 signups/hr; only trips on a flood. Tripped signups get 0
# free credits (can still buy) and it's logged.
ALOUD_FREE_GRANT_BUDGET_PER_HOUR=2000

# Soft-launch brake (also tunable live via the admin panel): when 1, metered
# endpoints (LLM/STT/TTS) refuse with `service_paused` — signed-up users keep
# their granted credits but can't spend yet. Unset/0 = spending open.
ALOUD_METERED_PAUSED=

# Emails exempt from ALOUD_METERED_PAUSED (the operator's own test accounts).
# Comma-separated, case-insensitive.
ALOUD_TESTER_EMAILS=

# Provider API keys — server-held; the client never sees these. At least one
# required in production.
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# OpenAI direct — powers the metered GPT-5.5 flagship LLM. A restricted key with
# "Model capabilities: Write" is all it needs (that scope covers chat completions
# AND audio/speech). This same key also backs OpenAI TTS by default (see
# OPENAI_TTS_API_KEY below), so ONE key lights up both GPT and gpt-4o-mini-tts.
OPENAI_API_KEY=

# Server-side STT (/cloud/v1/stt, Whisper). Backend is config-selected. The
# recommended default is OpenAI: if OPENAI_API_KEY (above) is set, STT uses
# gpt-4o-transcribe automatically (~$0.36/hr upstream) - one key already runs
# the GPT LLM + OpenAI TTS, and now STT too. On the OpenAI backend the client
# asks for the newer gpt-transcribe per-call (?model=..., July 2026: 25% cheaper
# upstream, more accurate) - that is what the app's "aloud cloud" STT choice now
# means, with gpt-4o-transcribe still offered as "aloud cloud - old"; each
# debits at its own provider cost like every leg (src/pricing/providers.ts
# STT_USD_PER_SECOND_BY_MODEL).
# Override only if you want otherwise:
#   OPENAI_STT_API_KEY → split STT onto its own OpenAI key (else reuses OPENAI_API_KEY)
#   STT_MODEL=gpt-transcribe → make the cheaper model the server default too
#   GROQ_API_KEY above → legacy (cheapest upstream, but new paid signups are frozen)
# Or pin any OpenAI-compatible /audio/transcriptions host explicitly (this is how
# you'd point at a self-hosted Whisper, or Fireworks if it ever ships audio again).
# STT_PROVIDER is just a log/debit label; STT_BASE_URL and STT_MODEL default to
# OpenAI if omitted:
#   STT_API_KEY=...
#   STT_PROVIDER=openai
#   STT_BASE_URL=https://api.openai.com/v1/audio/transcriptions
#   STT_MODEL=gpt-4o-transcribe

# Gemini direct (Google AI Studio key) — powers the value-tier model
# (gemini-2.5-flash-lite) without OpenRouter's middleman fee. Also doubles as
# the LLM-side Google key; Cloud Text-to-Speech uses GOOGLE_TTS_API_KEY below.
GEMINI_API_KEY=

# Google Cloud Text-to-Speech key (Cloud TTS API enabled) — powers the server-side
# Google voices (Chirp3-HD/Neural2) on /cloud/v1/tts. Distinct from GEMINI_API_KEY
# (AI Studio) above; may be the same project or a different one.
GOOGLE_TTS_API_KEY=

# OpenAI key for gpt-4o-mini-tts (the curated OpenAI voices on /cloud/v1/tts).
# Defaults to OPENAI_API_KEY above — set this ONLY to put TTS on a separate key
# from the LLM. Independent of GOOGLE_TTS_API_KEY: either provider enables hosted
# TTS, and each provider's voices appear in the picker only when its key is set.
# Without ANY TTS key, /cloud/v1/tts reports not-configured and the client falls
# back to browser speechSynthesis.
OPENAI_TTS_API_KEY=

# Stripe (optional in dev). Without these, billing routes report "not
# configured" and the server runs on the free-tier grant alone.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# x402 — pay for credit packs in USDC on Base (meditation-pal-du9). OFF unless
# X402_ENABLED=1 AND X402_PAY_TO_ADDRESS is set; otherwise the x402 buy route
# reports "not configured" and the UI hides the "Pay with USDC" option.
#   X402_PAY_TO_ADDRESS — a dedicated treasury Base address you hold keys to
#     (NOT the personal tip-jar address). USDC settles here.
#   X402_NETWORK — 'base-sepolia' (testnet, keyless facilitator — use this until
#     the live e2e test passes) or 'base' (mainnet; needs the CDP keys below and
#     is not fully wired yet, so it currently refuses — du9 Phase 3).
# Leave ALL of these unset in prod to keep the channel off until you're ready;
# set them in your local .env to demo it on testnet.
X402_ENABLED=
X402_PAY_TO_ADDRESS=
X402_NETWORK=
# CDP (Coinbase) facilitator keys — ONLY for mainnet (X402_NETWORK=base). Secrets.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# Bearer token for the /cloud/v1/admin/* endpoints (spend monitoring, grants).
# Generate: openssl rand -hex 32. The admin surface is enabled when this OR
# ALOUD_ADMIN_EMAILS is set; with neither, every admin route 404s.
ALOUD_ADMIN_TOKEN=

# Admin access via normal sign-in (comma-separated emails). A signed-in session
# whose VERIFIED account email is on this list can use the admin panel and
# endpoints — so on a phone you sign in with Google instead of carrying the
# token; the device then only holds a 7-day session JWT. Remove an email to
# revoke. The panel's sign-in button uses the FIRST id in GOOGLE_CLIENT_IDS
# (the web client), and that OAuth client must list this server's origin
# (e.g. https://aloud-cloud.fly.dev) under "Authorized JavaScript origins".
ALOUD_ADMIN_EMAILS=

# Optional: serve the built UI (ui/dist) from this same process — the single-box
# "full install" self-host story. Point it at the built UI directory. Leave unset
# for the canonical deploy where the UI is on a static host (e.g. GitHub Pages)
# and this box is API-only. Example: ALOUD_UI_DIR=../ui/dist
ALOUD_UI_DIR=

# NOTE: VITE_ALOUD_CLOUD_URL does NOT belong here - the server never reads it.
# It's a UI build-time variable; the committed default lives in
# ts/ui/.env.production (see dev-docs/mobile.md).
