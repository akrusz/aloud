
# Use bd merge for beads JSONL files
.beads/issues.jsonl merge=beads

# Shell scripts: force LF line endings
*.sh text eol=lf
*.command text eol=lf

# Binary assets
*.icns binary

# Vendored crates stay byte-identical to the published tarball: ort-sys's build
# script reads dist.txt and a CRLF checkout (Windows CI) breaks its hash parse.
ts/src-tauri/patches/** -text
