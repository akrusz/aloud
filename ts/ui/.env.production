# Loaded by `vite build` only (production mode) - dev servers ignore this file,
# so the Vite proxy keeps handling /cloud + /app in dev. A real environment
# variable (e.g. CI's ALOUD_CLOUD_URL repo var) overrides it.
#
# The hosted aloud cloud origin, baked into static/desktop/mobile builds so
# sign-in, credits, and metered STT/LLM/TTS work outside the dev proxy.
VITE_ALOUD_CLOUD_URL=https://aloud-cloud.fly.dev
