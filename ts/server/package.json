{
    "name": "@aloud/server",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "description": "aloud cloud proxy: stateless LLM/STT/TTS forwarding with OAuth, a credits ledger, and metered billing. Open source (AGPL-3.0) like the rest of aloud — see ts/server/README.md for why that's a feature, not a constraint.",
    "main": "./dist/index.js",
    "engines": {
        "node": ">=22.5"
    },
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "start": "tsx src/index.ts",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "test": "vitest run",
        "test:watch": "vitest",
        "voices": "tsx scripts/preview-voices.ts"
    },
    "dependencies": {
        "@hono/node-server": "^2.0.11",
        "hono": "^4.6.0",
        "jose": "^5.9.0",
        "tsx": "^4.19.0"
    },
    "devDependencies": {
        "typescript": "^5.6.0",
        "vitest": "^3.0.0"
    }
}
